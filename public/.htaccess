# Custom 404 Error Page
ErrorDocument 404 /404.html

# Enable RewriteEngine
RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Force non-www (www -> no-www)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Return 410 Gone for old WordPress URLs (images, uploads, etc.)
# Tells search engines these resources are permanently removed
RewriteRule ^wp-content/ - [G,L]
RewriteRule ^wp-includes/ - [G,L]
RewriteRule ^wp-admin/ - [G,L]

# 301 Redirects - Old site URLs to new site URLs
RewriteRule ^aboutus/?$ /about-dr-soma/ [R=301,L]
RewriteRule ^blogs/?$ /blog/ [R=301,L]
RewriteRule ^contact-us/?$ /contact/ [R=301,L]
RewriteRule ^servicespage/?$ /treatments/ [R=301,L]
RewriteRule ^servicespage/breast-augmentation-implant-in-malaysia/?$ /breast/breast-augmentation-malaysia/ [R=301,L]
RewriteRule ^servicespage/breast-lift/?$ /breast/breast-lift-malaysia/ [R=301,L]
RewriteRule ^servicespage/safe-breast-reduction-in-malaysia/?$ /breast/breast-reduction-malaysia/ [R=301,L]
RewriteRule ^servicespage/fat-transfer/?$ /breast/fat-transfer-breast-augmentation-malaysia/ [R=301,L]
RewriteRule ^servicespage/liposuction-malaysia-remove-unwanted-fat/?$ /body/liposuction-malaysia/ [R=301,L]
RewriteRule ^servicespage/six-pack-enhancement/?$ /body/six-pack-enhancement-malaysia/ [R=301,L]
RewriteRule ^servicespage/tummy-tuck-surgery-in-malaysia/?$ /body/tummy-tuck-malaysia/ [R=301,L]
RewriteRule ^servicespage/blepharoplasty-eyelid-reduction/?$ /face/eyelid-surgery-malaysia/ [R=301,L]
RewriteRule ^servicespage/face-lift-malaysia-to-combat-aging/?$ /face/face-lift-malaysia/ [R=301,L]
RewriteRule ^servicespage/otoplasty-pinnaplasty/?$ /face/otoplasty-malaysia/ [R=301,L]
RewriteRule ^servicespage/rhinoplasty-in-malaysia-enhance-nose-appearance/?$ /face/rhinoplasty-malaysia/ [R=301,L]
RewriteRule ^servicespage/male-breast-reduction/?$ /male/male-breast-reduction-malaysia/ [R=301,L]
RewriteRule ^servicespage/penile-enhancement/?$ /male/penile-enhancement-malaysia/ [R=301,L]
RewriteRule ^servicespage/skin-care/?$ /aesthetic-treatments/ [R=301,L]
RewriteRule ^servicespage/keloid-scar-treatment-in-malaysia/?$ /aesthetic-treatments/keloid-treatment-malaysia/ [R=301,L]
RewriteRule ^servicespage/lip-filler-malaysia-no-surgery-needed/?$ /aesthetic-treatments/lip-filler-malaysia/ [R=301,L]
RewriteRule ^servicespage/safe-thread-lift-in-malaysia/?$ /aesthetic-treatments/thread-lift-malaysia/ [R=301,L]
RewriteRule ^servicespage/cellular-rejuvenation-therapies/?$ /regenerative-treatments/cellular-rejuvenation-malaysia/ [R=301,L]
RewriteRule ^servicespage/exion/?$ /regenerative-treatments/exion-treatment-malaysia/ [R=301,L]
RewriteRule ^servicespage/exosomes-therapy/?$ /regenerative-treatments/prp-treatment-malaysia/ [R=301,L]
RewriteRule ^servicespage/advanced-wound-management/?$ /treatments/advanced-wound-management/ [R=301,L]

# Old WordPress blog posts at root -> redirect to /blog/
RewriteRule ^arm-liposuction-malaysia/?$ /blog/arm-liposuction-malaysia/ [R=301,L]
RewriteRule ^facelift-kuala-lumpur-malaysia/?$ /blog/facelift-kuala-lumpur-malaysia/ [R=301,L]
RewriteRule ^facelift-price-malaysia/?$ /blog/facelift-price-malaysia/ [R=301,L]
RewriteRule ^guide-liposuction-malaysia/?$ /blog/guide-liposuction-malaysia/ [R=301,L]
RewriteRule ^kos-sedut-lemak/?$ /blog/kos-sedut-lemak/ [R=301,L]
RewriteRule ^liposuction-price-malaysia/?$ /blog/liposuction-price-malaysia/ [R=301,L]
RewriteRule ^panduan-pembedahan-sedut-lemak/?$ /blog/panduan-pembedahan-sedut-lemak/ [R=301,L]
RewriteRule ^sedut-lemak-dagu-malaysia/?$ /blog/sedut-lemak-dagu-malaysia/ [R=301,L]
RewriteRule ^sedut-lemak-lengan-malaysia/?$ /blog/sedut-lemak-lengan-malaysia/ [R=301,L]
RewriteRule ^sedut-lemak-paha/?$ /blog/sedut-lemak-paha/ [R=301,L]
RewriteRule ^sedut-lemak-perut/?$ /blog/sedut-lemak-perut/ [R=301,L]
RewriteRule ^stomach-liposuction-malaysia/?$ /blog/stomach-liposuction-malaysia/ [R=301,L]
RewriteRule ^thigh-liposuction-malaysia/?$ /blog/thigh-liposuction-malaysia/ [R=301,L]

# Language URL rewrites - serve same content for locale-prefixed URLs
# English is default (no prefix needed)
# /id/     -> Indonesia
# /zh-cn/  -> Chinese (China)
# /zh-my/  -> Chinese (Malaysia)
# /ms/     -> Malay
# /ko/     -> Korean

# Locale paths - strip prefix and serve .html file directly
# e.g. /ms/contact -> /contact.html, /id/body/liposuction-malaysia -> /body/liposuction-malaysia.html
RewriteCond %{REQUEST_URI} ^/(id|zh-cn|zh-my|ms|ko)/(.+?)/?$
RewriteCond %{DOCUMENT_ROOT}/%2.html -f
RewriteRule ^(id|zh-cn|zh-my|ms|ko)/(.+?)/?$ /$2.html [L]

# Locale paths - handle directory-style pages (index.html inside folder)
RewriteCond %{REQUEST_URI} ^/(id|zh-cn|zh-my|ms|ko)/(.+?)/?$
RewriteCond %{DOCUMENT_ROOT}/%2/index.html -f
RewriteRule ^(id|zh-cn|zh-my|ms|ko)/(.+?)/?$ /$2/index.html [L]

# Handle locale root URLs (e.g., /id/ -> /)
RewriteRule ^(id|zh-cn|zh-my|ms|ko)/?$ /index.html [L]

# Serve .html files for clean URLs (any path depth, with or without trailing slash)
# e.g. /contact -> /contact.html, /body/liposuction-malaysia -> /body/liposuction-malaysia.html
RewriteCond %{REQUEST_URI} ^/(.+?)/?$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/%1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Handle trailing slash for directories
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ /404.html [L]
